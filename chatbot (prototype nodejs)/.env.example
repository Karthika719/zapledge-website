NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Create a fine-grained Hugging Face token with the Inference preset.
HF_TOKEN=hf_replace_me

# Keep the model configurable so interns can experiment without changing code.
# The :cheapest suffix asks HF Inference Providers to route to the lowest-cost available provider.
HF_MODEL=Qwen/Qwen3-8B:cheapest
HF_MAX_TOKENS=300
HF_TEMPERATURE=0.7

# Basic abuse protection. Useful even during experiments to protect free credits.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=30

# Chroma server or Chroma Cloud connection.
# Local Docker/CLI setup exposes Chroma on host port 8100.
CHROMA_URL=http://localhost:8100
CHROMA_COLLECTION=zapledge-knowledge
# Set this only when using an authenticated Chroma deployment.
# CHROMA_API_KEY=
