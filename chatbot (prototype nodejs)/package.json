{
  "name": "hf-chatbot-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript backend for a website chatbot using Hugging Face Inference Providers.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test src/**/*.test.ts",
    "test:watch": "tsx --test --watch src/**/*.test.ts",
    "knowledge:test": "tsx src/scripts/test-knowledge.ts",
    "knowledge:chunks": "tsx src/scripts/test-chunks.ts",
    "knowledge:embedding": "tsx src/scripts/test-embedding.ts",
    "knowledge:similarity": "tsx src/scripts/test-similarity.ts",
    "knowledge:search": "tsx src/scripts/test-knowledge-search.ts",
    "knowledge:retrieval": "tsx src/scripts/test-retrieval.ts",
    "intent:test": "tsx src/scripts/test-intent.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@huggingface/inference": "^4.0.0",
    "@huggingface/transformers": "^4.2.0",
    "chromadb": "^3.5.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  }
}
